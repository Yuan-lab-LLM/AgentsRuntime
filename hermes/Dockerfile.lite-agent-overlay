# Preserve the native runtime payload and configuration; update its Lite manager and required sandbox tools.
# Use an immutable BASE_IMAGE from the same runtime type.
ARG BASE_IMAGE
FROM golang:1.26.8-bookworm@sha256:9fdc884aacc3bec89b20ffc69f4bb369c78210e3e4f600387b5128b12c199f81 AS manager-builder
ARG GOPROXY=https://proxy.golang.org,direct
ARG GOSUMDB=sum.golang.org
COPY clawmanager-agent /src/clawmanager-agent
COPY hermes /src/hermes
WORKDIR /src/hermes
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -trimpath -ldflags="-s -w" -o /out/clawmanager-agent ./cmd/hermes-lite-agent
FROM ${BASE_IMAGE}
# Older overlay bases can predate isolated networking. Match Dockerfile.lite's
# fixed tool paths before advertising any container slot as ready.
RUN if [ ! -x /usr/sbin/ip ] || [ ! -x /usr/sbin/nft ]; then \
      apt-get update && apt-get install -y --no-install-recommends iproute2 nftables && \
      rm -rf /var/lib/apt/lists/*; \
    fi
COPY --from=manager-builder /out/clawmanager-agent /usr/local/bin/clawmanager-agent
# The compatibility manifest includes the manager hash. Recompute it using the
# original image-owned verifier; never inherit acceptance of another payload.
RUN python3 /usr/local/share/hermes-lite/verify_lite_release.py --lock /usr/local/share/hermes-lite/source-lock.json --generate-release --verify-release
