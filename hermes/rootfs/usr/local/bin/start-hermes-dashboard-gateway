#!/usr/bin/env bash
set -euo pipefail

umask "${CLAWMANAGER_TEAM_UMASK:-0002}"

export HOME="${HOME:-/config}"
export HERMES_HOME="${HERMES_HOME:-${HOME}/.hermes}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-${HOME}/.cache}"
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-${HOME}/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}"
export NPM_CONFIG_CACHE="${NPM_CONFIG_CACHE:-${XDG_CACHE_HOME}/npm}"
export UV_CACHE_DIR="${UV_CACHE_DIR:-${XDG_CACHE_HOME}/uv}"
export HERMES_ACCEPT_HOOKS="${HERMES_ACCEPT_HOOKS:-1}"

mkdir -p \
    "${HERMES_HOME}" \
    "${NPM_CONFIG_CACHE}" \
    "${UV_CACHE_DIR}" \
    "${XDG_CONFIG_HOME}" \
    "${XDG_DATA_HOME}"

/usr/local/bin/hermes-apply-runtime-config >/dev/null 2>&1 || true

env_file="${HERMES_HOME}/.env"
if [ -f "${env_file}" ]; then
    while IFS= read -r line || [ -n "${line:-}" ]; do
        line="${line%$'\r'}"
        [[ "${line}" =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] || continue
        key="${line%%=*}"
        value="${line#*=}"
        if [[ "${value}" == \"*\" && "${value}" == *\" ]]; then
            value="${value:1:${#value}-2}"
            value="${value//\\\"/\"}"
            value="${value//\\\\/\\}"
        elif [[ "${value}" == \'*\' && "${value}" == *\' ]]; then
            value="${value:1:${#value}-2}"
        fi
        export "${key}=${value}"
    done <"${env_file}"
fi

port="${CLAWMANAGER_GATEWAY_PORT:-${PORT:-9119}}"
host="${HOST:-0.0.0.0}"

case "${port}" in
    ''|*[!0-9]*)
        echo "invalid Hermes dashboard port: ${port}" >&2
        exit 64
        ;;
esac

team_worker_port="${HERMES_TEAM_WORKER_PORT:-${CLAWMANAGER_TEAM_WORKER_PORT:-$((port + 10000))}}"
case "${team_worker_port}" in
    ''|*[!0-9]*)
        echo "invalid Hermes Redis Team worker port: ${team_worker_port}" >&2
        exit 64
        ;;
esac
if [ "${team_worker_port}" -lt 1 ] || [ "${team_worker_port}" -gt 65535 ] || [ "${team_worker_port}" -eq "${port}" ]; then
    echo "Hermes Redis Team worker port must be distinct and within 1..65535: ${team_worker_port}" >&2
    exit 64
fi

truthy() {
    case "$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')" in
        1|true|yes|y|on|enabled) return 0 ;;
        *) return 1 ;;
    esac
}

falsey() {
    case "$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')" in
        0|false|no|n|off|disabled) return 0 ;;
        *) return 1 ;;
    esac
}

prepare_managed_bundled_skills() {
    local profile_home="${1:-}"
    local bundled_root="/config/.hermes/skills"
    local managed_marker="${profile_home}/.clawmanager-managed-bundled-skills"
    local opt_out_marker="${profile_home}/.no-bundled-skills"
    local bundled_skill=""

    if [ -z "${CLAWMANAGER_WORKSPACE_PATH:-}" ] || [ -z "${profile_home}" ]; then
        return 0
    fi

    case ":${HERMES_SKILL_DIRS:-}:" in
        *":${bundled_root}:"*)
            bundled_skill="$(
                find "${bundled_root}" -mindepth 2 -maxdepth 2 -type f -name SKILL.md -print -quit 2>/dev/null || true
            )"
            ;;
    esac
    if [ -n "${bundled_skill}" ]; then
        if [ -f "${opt_out_marker}" ] && [ ! -f "${managed_marker}" ]; then
            echo "Hermes profile already opted out of bundled skill seeding"
            return 0
        fi
        if touch "${opt_out_marker}" "${managed_marker}" 2>/dev/null; then
            echo "Hermes managed Lite profile will reuse bundled skills from ${bundled_root}"
        else
            echo "Hermes managed Lite profile could not enable bundled skill reuse; using native profile seeding" >&2
        fi
        return 0
    fi

    if [ -f "${managed_marker}" ]; then
        rm -f "${opt_out_marker}" "${managed_marker}"
        echo "Hermes global bundled skills are unavailable; restored native profile seeding"
    fi
}

# Newer Hermes ignores --insecure for non-loopback binds; require a dashboard
# auth provider (basic auth) before binding HOST=0.0.0.0.
ensure_dashboard_basic_auth() {
    if [ -n "${HERMES_DASHBOARD_BASIC_AUTH_USERNAME:-}" ] && {
        [ -n "${HERMES_DASHBOARD_BASIC_AUTH_PASSWORD:-}" ] ||
            [ -n "${HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH:-}" ]
    }; then
        return 0
    fi

    export HERMES_DASHBOARD_BASIC_AUTH_USERNAME="${HERMES_DASHBOARD_BASIC_AUTH_USERNAME:-clawmanager}"

    if [ -z "${HERMES_DASHBOARD_BASIC_AUTH_PASSWORD:-}" ] && [ -z "${HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH:-}" ]; then
        if [ -n "${CLAWMANAGER_DASHBOARD_BASIC_AUTH_PASSWORD:-}" ]; then
            export HERMES_DASHBOARD_BASIC_AUTH_PASSWORD="${CLAWMANAGER_DASHBOARD_BASIC_AUTH_PASSWORD}"
        elif [ -n "${CLAWMANAGER_INSTANCE_ACCESS_TOKEN:-}" ]; then
            export HERMES_DASHBOARD_BASIC_AUTH_PASSWORD="${CLAWMANAGER_INSTANCE_ACCESS_TOKEN}"
        elif [ -n "${CLAWMANAGER_INSTANCE_TOKEN:-}" ]; then
            # ClawManager BuildGatewayEnv currently ships this key for AccessToken.
            export HERMES_DASHBOARD_BASIC_AUTH_PASSWORD="${CLAWMANAGER_INSTANCE_TOKEN}"
        elif [ -n "${CLAWMANAGER_GATEWAY_TOKEN:-}" ]; then
            export HERMES_DASHBOARD_BASIC_AUTH_PASSWORD="${CLAWMANAGER_GATEWAY_TOKEN}"
        else
            auth_file="${HERMES_HOME}/.clawmanager-dashboard-basic-auth"
            if [ -f "${auth_file}" ]; then
                export HERMES_DASHBOARD_BASIC_AUTH_PASSWORD="$(tr -d '\r\n' <"${auth_file}")"
            else
                if command -v openssl >/dev/null 2>&1; then
                    generated_password="$(openssl rand -hex 16)"
                else
                    generated_password="$(head -c 16 /dev/urandom | od -An -tx1 | tr -d ' \n')"
                fi
                umask 077
                printf '%s' "${generated_password}" >"${auth_file}"
                export HERMES_DASHBOARD_BASIC_AUTH_PASSWORD="${generated_password}"
            fi
        fi
    fi
}

should_start_team_gateway() {
    truthy "${CLAWMANAGER_TEAM_ENABLED:-}" || return 1
    falsey "${CLAWMANAGER_TEAM_AUTORUN:-true}" && return 1
    [ -n "${CLAWMANAGER_TEAM_REDIS_URL:-}" ] &&
        [ -n "${CLAWMANAGER_TEAM_ID:-}" ] &&
        [ -n "${CLAWMANAGER_TEAM_MEMBER_ID:-}" ]
}

team_gateway_pid=""
dashboard_pid=""
agent_pid=""
team_gateway_required="false"

start_instance_agent() {
    if [ "${CLAWMANAGER_AGENT_ENABLED:-false}" != "true" ]; then
        return 0
    fi
    if [ ! -x /usr/local/bin/clawmanager-agent ]; then
        echo "ClawManager instance agent binary missing or not executable" >&2
        return 0
    fi
    if [ -z "${CLAWMANAGER_AGENT_BOOTSTRAP_TOKEN:-}" ] && [ -z "${CLAWMANAGER_AGENT_SESSION_TOKEN:-}" ]; then
        echo "ClawManager instance agent skipped: missing bootstrap/session token" >&2
        return 0
    fi

    echo "Starting ClawManager Hermes instance agent for instance ${CLAWMANAGER_AGENT_INSTANCE_ID:-unknown}"
    (
        unset RUNTIME_AGENT_CONTROL_TOKEN
        unset RUNTIME_AGENT_REPORT_TOKEN
        unset RUNTIME_AGENT_DATA_DIR
        unset RUNTIME_AGENT_PUBLIC_PORT
        unset RUNTIME_AGENT_LISTEN_ADDR

        /usr/local/bin/clawmanager-agent &
        child_pid="$!"
        trap 'kill "${child_pid}" 2>/dev/null || true; wait "${child_pid}" 2>/dev/null || true; exit 143' INT TERM
        set +e
        wait "${child_pid}"
        status="$?"
        trap - INT TERM
        if [ "${status}" -ne 0 ]; then
            echo "ClawManager Hermes instance agent exited with status ${status}" >&2
        else
            echo "ClawManager Hermes instance agent exited" >&2
        fi
        exit "${status}"
    ) &
    agent_pid="$!"
}

shutdown() {
    trap - INT TERM
    if [ -n "${dashboard_pid}" ]; then
        kill "${dashboard_pid}" 2>/dev/null || true
    fi
    if [ -n "${agent_pid}" ]; then
        kill "${agent_pid}" 2>/dev/null || true
    fi
    if [ -n "${team_gateway_pid}" ]; then
        kill "${team_gateway_pid}" 2>/dev/null || true
    fi
    wait 2>/dev/null || true
    exit 143
}

trap shutdown INT TERM

prepare_team_startup_state() {
    local team_ready_file="${CLAWMANAGER_TEAM_READY_FILE:-${HERMES_TEAM_WORKER_HOME:-${HOME}/.clawmanager-team-worker}/.hermes/runtime/redis-team.ready.json}"
    mkdir -p "$(dirname "${team_ready_file}")"
    rm -f "${team_ready_file}" "${team_ready_file}.failed"
}

start_team_gateway() {
    echo "Preparing Hermes Redis Team consumer: member=${CLAWMANAGER_TEAM_MEMBER_ID} dashboard_port=${port} team_worker_port=${team_worker_port}"
    (
        team_worker_home="${HERMES_TEAM_WORKER_HOME:-${HOME}/.clawmanager-team-worker}"
        export HOME="${team_worker_home}"
        export HERMES_HOME="${team_worker_home}/.hermes"
        export XDG_CACHE_HOME="${team_worker_home}/.cache"
        export XDG_CONFIG_HOME="${team_worker_home}/.config"
        export XDG_DATA_HOME="${team_worker_home}/.local/share"
        export NPM_CONFIG_CACHE="${XDG_CACHE_HOME}/npm"
        export UV_CACHE_DIR="${XDG_CACHE_HOME}/uv"
        export CLAWMANAGER_GATEWAY_PORT="${team_worker_port}"
        export PORT="${team_worker_port}"
        # Team control-plane packets must never interrupt an active Worker turn.
        # Approval commands retain Hermes' native bypass path; ordinary follow-ups
        # are queued and busy acknowledgements stay out of Team chat.
        export HERMES_GATEWAY_BUSY_INPUT_MODE="${HERMES_TEAM_BUSY_INPUT_MODE:-queue}"
        export HERMES_GATEWAY_BUSY_TEXT_MODE="${HERMES_TEAM_BUSY_TEXT_MODE:-queue}"
        export HERMES_GATEWAY_BUSY_ACK_ENABLED="${HERMES_TEAM_BUSY_ACK_ENABLED:-false}"
        export CLAWMANAGER_HERMES_TEAM_WORKER_PROFILE=true
        export CLAWMANAGER_TEAM_READY_FILE="${CLAWMANAGER_TEAM_READY_FILE:-${HERMES_HOME}/runtime/redis-team.ready.json}"
        mkdir -p \
            "${HERMES_HOME}" \
            "${NPM_CONFIG_CACHE}" \
            "${UV_CACHE_DIR}" \
            "${XDG_CONFIG_HOME}" \
            "${XDG_DATA_HOME}" \
            "$(dirname "${CLAWMANAGER_TEAM_READY_FILE}")"
        prepare_managed_bundled_skills "${HERMES_HOME}"
        /usr/local/bin/hermes-apply-runtime-config
        cd "${team_worker_home}"
        exec hermes gateway run --accept-hooks --no-supervise
    ) &
    team_gateway_pid="$!"
    echo "Hermes Redis Team consumer started: team_gateway_pid=${team_gateway_pid} team_worker_port=${team_worker_port}"
    return 0
}

initialize_native_session_store() {
    # The Dashboard and redis_team gateway share Hermes' native Team profile.
    # Initialize/migrate the SQLite store once before either process starts so
    # two first-use connections cannot race while enabling WAL mode.
    PYTHONPATH="/usr/local/lib/hermes-agent${PYTHONPATH:+:${PYTHONPATH}}" python - <<'PY'
import os
from pathlib import Path

from hermes_state import SessionDB

db = SessionDB(Path(os.environ["HERMES_HOME"]) / "state.db")
db.close()
PY
}

start_instance_agent

if should_start_team_gateway; then
    team_gateway_required="true"
    instance_hermes_home="${HERMES_HOME}"
    team_worker_home="${HERMES_TEAM_WORKER_HOME:-${HOME}/.clawmanager-team-worker}"
    team_hermes_home="${team_worker_home}/.hermes"
    mkdir -p "${team_hermes_home}"
    for managed_identity in .env config.yaml SOUL.md AGENTS.md team.json team-introduction.md; do
        if [ -f "${instance_hermes_home}/${managed_identity}" ] && [ ! -e "${team_hermes_home}/${managed_identity}" ]; then
            cp "${instance_hermes_home}/${managed_identity}" "${team_hermes_home}/${managed_identity}"
        fi
    done
    # A Team-assigned Hermes Lite instance exposes the Team Worker's native
    # profile in the existing Dashboard. This lets redis_team tasks and
    # instance-desktop chats share Hermes' own state/session behavior without
    # copying SQLite data or patching the GUI. Non-Team instances keep the
    # ordinary profile selected above.
    export HOME="${team_worker_home}"
    export HERMES_HOME="${team_hermes_home}"
    export XDG_CACHE_HOME="${team_worker_home}/.cache"
    export XDG_CONFIG_HOME="${team_worker_home}/.config"
    export XDG_DATA_HOME="${team_worker_home}/.local/share"
    export NPM_CONFIG_CACHE="${XDG_CACHE_HOME}/npm"
    export UV_CACHE_DIR="${XDG_CACHE_HOME}/uv"
    mkdir -p "${NPM_CONFIG_CACHE}" "${UV_CACHE_DIR}" "${XDG_CONFIG_HOME}" "${XDG_DATA_HOME}"
    /usr/local/bin/hermes-apply-runtime-config
    initialize_native_session_store
    prepare_team_startup_state
fi

prepare_managed_bundled_skills "${HERMES_HOME}"
ensure_dashboard_basic_auth
echo "Starting Hermes dashboard gateway: dashboard_port=${port} host=${host}"
hermes dashboard \
    --host "${host}" \
    --port "${port}" \
    --no-open \
    --skip-build &
dashboard_pid="$!"
echo "Hermes dashboard gateway started: dashboard_pid=${dashboard_pid} dashboard_port=${port}"

if truthy "${team_gateway_required}"; then
    start_team_gateway
fi

wait_pids=("${dashboard_pid}")
if [ -n "${team_gateway_pid}" ]; then
    wait_pids+=("${team_gateway_pid}")
fi
if [ -n "${team_gateway_pid}" ] && [ -n "${agent_pid}" ]; then
    wait_pids+=("${agent_pid}")
fi

set +e
wait -n "${wait_pids[@]}"
status="$?"
set -e

if [ "${#wait_pids[@]}" -gt 1 ]; then
    echo "A required Hermes Team gateway component stopped: status=${status}" >&2
    if [ "${status}" -eq 0 ]; then
        status=1
    fi
fi

if [ -n "${agent_pid}" ]; then
    kill "${agent_pid}" 2>/dev/null || true
    wait "${agent_pid}" 2>/dev/null || true
fi

if [ -n "${team_gateway_pid}" ]; then
    kill "${team_gateway_pid}" 2>/dev/null || true
    team_status=0
    wait "${team_gateway_pid}" 2>/dev/null || team_status="$?"
    echo "Hermes Redis Team consumer stopped: team_gateway_pid=${team_gateway_pid} status=${team_status}"
fi
if [ -n "${dashboard_pid}" ]; then
    kill "${dashboard_pid}" 2>/dev/null || true
    wait "${dashboard_pid}" 2>/dev/null || true
fi

exit "${status}"
