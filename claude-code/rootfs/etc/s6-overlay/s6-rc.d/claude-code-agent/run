#!/usr/bin/with-contenv bash
set -euo pipefail
if [ "${CLAWMANAGER_AGENT_ENABLED:-false}" != "true" ]; then
  echo "ClawManager Claude Code instance agent disabled"
  exec sleep infinity
fi
export HOME="${HOME:-/config}"
export CLAUDE_CONFIG_DIR="${CLAUDE_CONFIG_DIR:-/config/.claude}"
mkdir -p "${CLAWMANAGER_AGENT_PERSISTENT_DIR:-/config}/claude-code-agent" "$CLAUDE_CONFIG_DIR"
exec /usr/local/bin/clawmanager-agent
