#!/usr/bin/with-contenv bash
set -euo pipefail
if [ "${CLAWMANAGER_RUNTIME_TYPE:-desktop}" != "desktop" ]; then exec sleep infinity; fi
for _ in $(seq 1 90); do
  if { [ -S /config/.XDG/wayland-0 ] || [ -S /tmp/.X11-unix/X1 ]; } && pgrep -u abc -x plasmashell >/dev/null 2>&1; then break; fi
  sleep 1
done
exec s6-setuidgid abc env HOME=/config DISPLAY=:1 WAYLAND_DISPLAY=wayland-0 XDG_RUNTIME_DIR=/config/.XDG XDG_SESSION_TYPE=wayland XDG_CURRENT_DESKTOP=KDE /usr/local/bin/start-claude-code-terminal
