# Local/release-smoke: published OpenClaw (lite or pro) + new clawmanager-agent only.
#
# From repository root (runtimeagent/):
#   # Lite pool
#   docker build -f openclaw/Dockerfile.agent-overlay.nosyntax `
#     --build-arg BASE_IMAGE=ghcr.io/yuan-lab-llm/agentsruntime/openclaw-lite:latest `
#     -t openclaw-lite:local .
#
#   # Pro dedicated
#   docker build -f openclaw/Dockerfile.agent-overlay.nosyntax `
#     --build-arg BASE_IMAGE=ghcr.io/yuan-lab-llm/agentsruntime/openclaw:latest `
#     -t openclaw:local .

ARG BASE_IMAGE=ghcr.io/yuan-lab-llm/agentsruntime/openclaw-lite:latest

FROM --platform=$BUILDPLATFORM golang:1.26.1-alpine AS clawmanager-agent-builder

WORKDIR /src/legacy-agent

ARG TARGETOS=linux
ARG TARGETARCH
ARG AGENT_VERSION=dev

COPY clawmanager-agent /src/clawmanager-agent
COPY legacy-agent /src/legacy-agent
COPY openclaw/go.mod openclaw/go.sum /src/openclaw/
COPY openclaw/lite /src/openclaw/lite
COPY hermes/go.mod hermes/go.sum /src/hermes/
COPY hermes/lite /src/hermes/lite
COPY opencode/go.mod /src/opencode/
COPY opencode/lite /src/opencode/lite
COPY deepseek-harness/go.mod /src/deepseek-harness/
COPY deepseek-harness/lite /src/deepseek-harness/lite
COPY deepseek-harness/dshproxy /src/deepseek-harness/dshproxy
RUN go mod download

RUN set -eux; \
    arch="${TARGETARCH:-amd64}"; \
    CGO_ENABLED=0 GOOS="${TARGETOS}" GOARCH="${arch}" \
        go build -trimpath -ldflags="-s -w -X main.version=${AGENT_VERSION}" \
        -o /out/clawmanager-agent ./cmd

FROM ${BASE_IMAGE}

COPY openclaw/patches/ /usr/local/share/openclaw/patches/
RUN node /usr/local/share/openclaw/patches/test_managed_proxy_policy.mjs \
    && node /usr/local/share/openclaw/patches/patch_managed_proxy_policy.mjs --patch --allow-legacy --install-marker \
    && node /usr/local/share/openclaw/patches/test_managed_proxy_metadata.mjs --allow-legacy

COPY --from=clawmanager-agent-builder /out/clawmanager-agent /usr/local/bin/clawmanager-agent
RUN chmod 755 /usr/local/bin/clawmanager-agent
