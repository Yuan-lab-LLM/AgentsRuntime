# Maintenance overlay for a pinned Team-compatible 2026.10.2 serving image.
# Agent, workspace adapters, entrypoint and core are retained without migration.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG RUNTIME_REVISION
COPY plugins/openclaw-redis-team/dist/index.js /tmp/redis-team-index.js
RUN set -eu; \
    core="$(dirname "$(readlink -f "$(command -v openclaw)")")"; \
    test -f "$core/package.json"; \
    test -d "$core/dist/extensions/redis-team/dist"; \
    cp /tmp/redis-team-index.js "$core/dist/extensions/redis-team/dist/index.js"; \
    cp /tmp/redis-team-index.js /defaults/.openclaw/extensions/redis-team/dist/index.js; \
    chown abc:abc /defaults/.openclaw/extensions/redis-team/dist/index.js; \
    node --check /defaults/.openclaw/extensions/redis-team/dist/index.js; \
    node --input-type=module -e 'const m=await import("/defaults/.openclaw/extensions/redis-team/dist/index.js");if(!m.default)process.exit(1)'; \
    openclaw --version | grep '2026.10.2'; \
    rm /tmp/redis-team-index.js
LABEL io.clawmanager.team-source-revision="${RUNTIME_REVISION}"
