#!/usr/bin/with-contenv bash
set -e
export HOME="${HOME:-/config}"
export CODEX_HOME="${CODEX_HOME:-/config/.codex}"
export CLAWMANAGER_PROJECT_PATH="${CLAWMANAGER_PROJECT_PATH:-/config/workspace}"
mkdir -p "$CODEX_HOME" "$CLAWMANAGER_PROJECT_PATH" "${CLAWMANAGER_AGENT_PERSISTENT_DIR:-/config}/codex-agent" /config/.config/autostart
if [ -n "${CLAWMANAGER_LLM_BASE_URL:-}" ] && [ -n "${CLAWMANAGER_LLM_API_KEY:-}" ]; then
  # Codex appends /responses to the configured provider base URL. The
  # ClawManager Responses compatibility route is /v1/responses.
  export OPENAI_BASE_URL="${CLAWMANAGER_LLM_BASE_URL%/}/v1"
  export OPENAI_API_BASE="${CLAWMANAGER_LLM_BASE_URL%/}/v1"
  export OPENAI_API_KEY="$CLAWMANAGER_LLM_API_KEY"
  export OPENAI_MODEL="${OPENAI_MODEL:-auto}"
  export CODEX_MODEL_CATALOG_PATH="$CODEX_HOME/model_catalog.json"
  # Custom providers are not included in Codex's bundled model catalog. Build
  # a per-instance catalog from ClawManager's allow-list so Codex knows the
  # selected model's capabilities instead of falling back to unknown metadata.
  node <<'NODE'
const fs = require('fs');

const catalogPath = process.env.CODEX_MODEL_CATALOG_PATH;
const configuredModel = (process.env.OPENAI_MODEL || '').trim();
let allowedModels = [];
try {
  const value = JSON.parse(process.env.CLAWMANAGER_LLM_MODEL || '[]');
  if (Array.isArray(value)) allowedModels = value;
} catch (_) {
  // The selected model below is still catalogued when an older runtime does
  // not provide a valid allow-list.
}

const modelIds = [...new Set([...allowedModels, configuredModel]
  .filter((value) => typeof value === 'string')
  .map((value) => value.trim())
  .filter((value) => value && value !== 'auto'))];

const catalog = {
  models: modelIds.map((slug, priority) => ({
    slug,
    display_name: slug,
    description: 'Model managed by ClawManager AI Gateway.',
    base_instructions: 'You are Codex, a coding agent. Work with the user to complete tasks in the shared workspace.',
    default_reasoning_level: 'none',
    supported_reasoning_levels: [{ effort: 'none', description: 'Gateway-managed reasoning' }],
    shell_type: 'shell_command',
    visibility: 'list',
    supported_in_api: true,
    priority,
    supports_reasoning_summaries: false,
    default_reasoning_summary: 'none',
    support_verbosity: false,
    default_verbosity: null,
    apply_patch_tool_type: 'freeform',
    web_search_tool_type: 'text',
    truncation_policy: { mode: 'bytes', limit: 10000 },
    supports_parallel_tool_calls: true,
    supports_image_detail_original: false,
    context_window: 128000,
    max_context_window: 128000,
    auto_compact_token_limit: null,
    experimental_supported_tools: [],
    input_modalities: ['text', 'image']
  }))
};

if (catalog.models.length === 0) {
  throw new Error('ClawManager did not inject a usable Codex model');
}
fs.writeFileSync(catalogPath, `${JSON.stringify(catalog, null, 2)}\n`, { mode: 0o600 });
NODE
  # Codex loads this file before considering its OpenAI login state.  Pinning a
  # named provider makes every model request use the governed Responses route.
  # The credential remains in the injected environment instead of the file.
  cat >"$CODEX_HOME/config.toml" <<EOF
# Managed by ClawManager. This file is replaced on each container start.
model = "${OPENAI_MODEL}"
model_provider = "clawmanager"
model_catalog_json = "${CODEX_MODEL_CATALOG_PATH}"

[model_providers.clawmanager]
name = "ClawManager AI Gateway"
base_url = "${CLAWMANAGER_LLM_BASE_URL%/}/v1"
env_key = "CLAWMANAGER_LLM_API_KEY"
wire_api = "responses"
requires_openai_auth = false
EOF
  chmod 600 "$CODEX_HOME/config.toml"
fi
if command -v git >/dev/null 2>&1 && [ ! -d "$CLAWMANAGER_PROJECT_PATH/.git" ]; then git -C "$CLAWMANAGER_PROJECT_PATH" init --quiet || true; fi
cat >/config/.config/autostart/codex.desktop <<'DESKTOP'
[Desktop Entry]
Type=Application
Name=Codex
Exec=/usr/local/bin/start-codex-terminal
Terminal=false
X-KDE-Autostart-enabled=true
DESKTOP
mkdir -p /config/.config/openbox
touch /config/.config/openbox/autostart
if ! grep -q 'start-codex-terminal' /config/.config/openbox/autostart 2>/dev/null; then
  echo '(/usr/local/bin/start-codex-terminal) &' >>/config/.config/openbox/autostart
fi
chown -R abc:abc "$CODEX_HOME" "$CLAWMANAGER_PROJECT_PATH" /config/.config 2>/dev/null || true
