#!/usr/bin/env bash
set -euo pipefail

# Webtop runs the desktop as user abc with HOME=/config. Keep all WorkBuddy
# state on the persistent /config volume and avoid starting a duplicate copy.
export HOME="${HOME:-/config}"
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"

mkdir -p "$XDG_CONFIG_HOME" "$XDG_CACHE_HOME" "$XDG_DATA_HOME"

if pgrep -u "$(id -u)" -f '/opt/workbuddy/(electron|start\.sh)' >/dev/null 2>&1; then
    exit 0
fi

exec /opt/workbuddy/start.sh "$@"
