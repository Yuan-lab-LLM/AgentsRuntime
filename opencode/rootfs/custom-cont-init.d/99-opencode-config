#!/usr/bin/with-contenv bash
set -e

export HOME="${HOME:-/config}"
export OPENCODE_CONFIG_DIR="${OPENCODE_CONFIG_DIR:-/config/.opencode}"
export CLAWMANAGER_PROJECT_PATH="${CLAWMANAGER_PROJECT_PATH:-/config/workspace}"
export CLAWMANAGER_DEFAULT_PROJECT_PATH="${CLAWMANAGER_DEFAULT_PROJECT_PATH:-${CLAWMANAGER_PROJECT_PATH}/project}"

mkdir -p \
  /config/.cache \
  /config/.config \
  /config/.config/autostart \
  /config/.config/openbox \
  /config/.local/share \
  "${CLAWMANAGER_PROJECT_PATH}" \
  "${CLAWMANAGER_DEFAULT_PROJECT_PATH}" \
  "${OPENCODE_CONFIG_DIR}" \
  "${CLAWMANAGER_AGENT_PERSISTENT_DIR:-/config}/opencode-agent"

/usr/local/bin/opencode-apply-runtime-config || true

if command -v git >/dev/null 2>&1 && [ ! -d "${CLAWMANAGER_DEFAULT_PROJECT_PATH}/.git" ]; then
  git -C "${CLAWMANAGER_DEFAULT_PROJECT_PATH}" init --quiet || true
fi

# Runtime-pod (Lite) containers do not have a user desktop.  A dedicated Pro
# desktop does, so arrange for its OpenCode terminal to open with the session.
if [ "${CLAWMANAGER_RUNTIME_TYPE:-}" = "desktop" ]; then
  cat >/config/.config/autostart/opencode-runtime.desktop <<'DESKTOP'
[Desktop Entry]
Type=Application
Name=OpenCode Runtime
Comment=Open OpenCode automatically
Exec=/usr/local/bin/start-opencode-terminal
Terminal=false
X-KDE-Autostart-enabled=true
DESKTOP
  chmod 755 /config/.config/autostart/opencode-runtime.desktop

  # Webtop images can start a session without an XDG autostart manager. Keep
  # the Openbox fallback so the terminal still opens on those variants.
  touch /config/.config/openbox/autostart
  if ! grep -q 'start-opencode-terminal' /config/.config/openbox/autostart 2>/dev/null; then
    {
      echo ''
      echo '# OpenCode Runtime autostart'
      echo '(/usr/local/bin/start-opencode-terminal) &'
    } >>/config/.config/openbox/autostart
  fi
  chmod 755 /config/.config/openbox/autostart
fi

if id abc >/dev/null 2>&1; then
  chown -R abc:abc \
    /config/.cache \
    /config/.config \
    /config/.local \
    "${CLAWMANAGER_PROJECT_PATH}" \
    "${CLAWMANAGER_DEFAULT_PROJECT_PATH}" \
    "${OPENCODE_CONFIG_DIR}" \
    2>/dev/null || true
fi
