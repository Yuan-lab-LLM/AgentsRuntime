#!/usr/bin/with-contenv bash
set -euo pipefail

# Lite instances share a Runtime Pod and have no desktop session.  Pro runs in
# Webtop, where KDE does not reliably honour XDG autostart entries.
if [ "${CLAWMANAGER_RUNTIME_TYPE:-}" != "desktop" ]; then
  exec sleep infinity
fi

for _ in $(seq 1 90); do
  if { [ -S /config/.XDG/wayland-0 ] || [ -S /tmp/.X11-unix/X1 ]; } && pgrep -u abc -x plasmashell >/dev/null 2>&1; then
    break
  fi
  sleep 1
done

if ! command -v s6-setuidgid >/dev/null 2>&1; then
  echo "opencode-terminal: s6-setuidgid is unavailable" >&2
  exec sleep infinity
fi

# Chromium is started as the desktop user. A persistent /config volume may
# contain a Crashpad profile left by an older root-launched browser, which
# makes Chromium abort before showing OpenCode. Repair only Chromium's own
# profile here; workspace and OpenCode data are intentionally untouched.
mkdir -p /config/.config/chromium
chown -R abc:abc /config/.config/chromium 2>/dev/null || true

exec s6-setuidgid abc env \
  HOME=/config \
  DISPLAY=:1 \
  WAYLAND_DISPLAY=wayland-0 \
  XDG_RUNTIME_DIR=/config/.XDG \
  XDG_SESSION_TYPE=wayland \
  XDG_CURRENT_DESKTOP=KDE \
  /usr/local/bin/start-opencode-terminal
