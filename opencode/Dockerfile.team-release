# syntax=docker/dockerfile:1.7
# Maintenance release: a pinned native binary built/tested from the governed
# source, supplied through --build-context team-native=... . Keep the serving
# image's existing Agent, entrypoint and legacy/slot activation unchanged.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG NATIVE_SHA256
ARG RUNTIME_REVISION
COPY --from=team-native /opencode /usr/local/bin/opencode
COPY --from=team-native /governance-manifest.json /usr/local/share/clawmanager/opencode-governance-manifest.json
COPY opencode/team/ /usr/local/share/clawmanager/opencode-team/
COPY opencode/model-governance/team-tools.ts /tmp/team-tools.ts
COPY plugins/openclaw-redis-team/dist/index.js /tmp/team-protocol.js
RUN test -n "$NATIVE_SHA256" \
 && printf '%s  /usr/local/bin/opencode\n' "$NATIVE_SHA256" | sha256sum -c - \
 && chmod 0755 /usr/local/bin/opencode \
 && /usr/local/bin/opencode --version | grep -Fx 'opencode v2.0.27' \
 && node -e 'const fs=require("fs"),c=require("crypto"),m=JSON.parse(fs.readFileSync("/usr/local/share/clawmanager/opencode-governance-manifest.json"));const h=c.createHash("sha256").update(fs.readFileSync("/tmp/team-tools.ts","utf8").replaceAll("\r\n","\n")).digest("hex");if(m.teamTools!==h)throw Error("Native Team adapter provenance mismatch")' \
 && node /usr/local/share/clawmanager/opencode-team/build-protocol.mjs /usr/local/share/clawmanager/opencode-team/protocol.mjs /tmp/team-protocol.js \
 && rm /tmp/team-tools.ts /tmp/team-protocol.js
LABEL io.clawmanager.team-source-revision="${RUNTIME_REVISION}"
