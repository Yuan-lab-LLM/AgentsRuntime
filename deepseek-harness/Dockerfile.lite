# syntax=docker/dockerfile:1.7
# Build from the AgentsRuntime repository root; the runtime composes the shared core.
FROM --platform=$BUILDPLATFORM golang:1.26.8-bookworm@sha256:9fdc884aacc3bec89b20ffc69f4bb369c78210e3e4f600387b5128b12c199f81 AS agent-builder
ARG TARGETOS=linux
ARG TARGETARCH
ARG AGENT_VERSION=dev
COPY clawmanager-agent/ /src/clawmanager-agent/
COPY deepseek-harness/ /src/deepseek-harness/
WORKDIR /src/deepseek-harness
RUN go mod download
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH:-amd64} \
    go build -mod=readonly -trimpath -ldflags="-s -w -X main.version=${AGENT_VERSION}" \
    -o /out/clawmanager-agent ./cmd/deepseek-harness-lite-agent

FROM node:22-bookworm-slim@sha256:53ada149d435c38b14476cb57e4a7da73c15595aba79bd6971b547ceb6d018bf

ARG DSH_VERSION=0.1.2-alpha.3
ARG PNPM_VERSION=11.25.0
ARG DEBIAN_FRONTEND=noninteractive

ENV CLAWMANAGER_RUNTIME_TYPE=deepseek-harness \
    RUNTIME_WORKSPACE_ROOT=/workspaces \
    RUNTIME_AGENT_DATA_DIR=/var/lib/clawmanager-agent \
    RUNTIME_GATEWAY_COMMAND=/usr/local/bin/start-deepseek-harness-gateway \
    DSH_TELEMETRY_DISABLED=1

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      bash \
      bubblewrap \
      iproute2 \
      nftables \
      build-essential \
      ca-certificates \
      curl \
      git \
      jq \
      openssh-client \
      python3 \
      python3-pip \
      ripgrep \
      tini \
      unzip \
      util-linux; \
    rm -rf /var/lib/apt/lists/*

# Lite gateways run as instance-specific, unprivileged UIDs. Keep pnpm in the
# shared image so plugin installs never need to modify the system Node prefix.
RUN set -eux; \
    npm install --global \
      "@deepseek-ai/dsh@${DSH_VERSION}" \
      "pnpm@${PNPM_VERSION}"; \
    dsh --version; \
    pnpm --version; \
    npm cache clean --force

COPY deepseek-harness/cordis.lock.json deepseek-harness/scripts/install-pinned-cordis.py /usr/local/share/deepseek-harness/
RUN --mount=type=bind,source=deepseek-harness/vendor/cordis,target=/pinned/cordis \
    python3 /usr/local/share/deepseek-harness/install-pinned-cordis.py /pinned/cordis

# DSH runs inside the instance's existing namespace. Keep its nested writable
# sandbox on that private persistent /tmp; never disable the sandbox itself.
COPY deepseek-harness/scripts/patch-persistent-tmp.py /usr/local/share/deepseek-harness/patch-persistent-tmp.py
RUN python3 /usr/local/share/deepseek-harness/patch-persistent-tmp.py \
    /usr/local/lib/node_modules/@deepseek-ai/dsh/node_modules/@deepseek-ai/dsh-sandbox-local/lib/index.js

COPY --from=agent-builder /out/clawmanager-agent /usr/local/bin/clawmanager-agent
COPY --from=agent-builder /out/clawmanager-agent /usr/local/libexec/clawmanager-agent-image
COPY deepseek-harness/config/managed.cordis.patch.yml /usr/local/share/deepseek-harness/managed.cordis.patch.yml
COPY deepseek-harness/scripts/prepare-deepseek-harness-resources /usr/local/bin/prepare-deepseek-harness-resources
COPY deepseek-harness/scripts/start-deepseek-harness-gateway /usr/local/bin/start-deepseek-harness-gateway
COPY deepseek-harness/scripts/deepseek-harness-lite-entrypoint /usr/local/bin/deepseek-harness-lite-entrypoint

RUN set -eux; \
    sed -i 's/\r$//' \
      /usr/local/bin/prepare-deepseek-harness-resources \
      /usr/local/bin/start-deepseek-harness-gateway \
      /usr/local/bin/deepseek-harness-lite-entrypoint; \
    chmod 0755 \
      /usr/local/bin/clawmanager-agent \
      /usr/local/libexec/clawmanager-agent-image \
      /usr/local/bin/prepare-deepseek-harness-resources \
      /usr/local/bin/start-deepseek-harness-gateway \
      /usr/local/bin/deepseek-harness-lite-entrypoint; \
    mkdir -p /var/lib/clawmanager-agent /workspaces; \
    chmod 0755 /var/lib/clawmanager-agent /workspaces

EXPOSE 19090 20300-20399

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/deepseek-harness-lite-entrypoint"]
